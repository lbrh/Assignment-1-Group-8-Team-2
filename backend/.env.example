IBM_CLOUD_API_KEY=
# watsonx.ai Studio project ID - project's Manage > General settings
WATSONX_PROJECT_ID=
# Deployment space ID - space's Manage settings
WATSONX_SPACE_ID=
# Region the watsonx.ai Studio/Runtime instances live in, e.g. ca-tor
WATSONX_REGION=

# Metadata database connection string (Postgres). Currently a free Neon project;
# swapping to IBM Cloud Databases for PostgreSQL later is just replacing this value.
DATABASE_URL=

# Cloud Object Storage (image storage). HMAC credentials

COS_ENDPOINT=
COS_BUCKET=
COS_ACCESS_KEY_ID=
COS_SECRET_ACCESS_KEY=

# To be filled out with relevant .env information

