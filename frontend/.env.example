# "true" to use the in-browser demo data instead of the backend; unset/anything else = real backend.
# Read at build time, so set it before `pnpm dev`/`pnpm build`, not just at runtime.
NEXT_PUBLIC_USE_MOCK_API=false

# Server-side only: read by the src/app/api/backend proxy, never sent to the browser.
# Deployed backend below. For a local backend use http://localhost:3000 and run the
# frontend on another port (pnpm dev -p 3001), since the backend also listens on 3000.
BACKEND_URL=https://assignment-1-backend.2f2h3a30vd69.ca-tor.codeengine.appdomain.cloud

# Must match the "frontend:<key>" entry in the backend's ALLOWED_API_KEYS.
BACKEND_API_KEY=
